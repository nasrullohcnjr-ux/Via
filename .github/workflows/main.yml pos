        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-6 transform transition-all scale-100 space-y-4">
            <div class="text-center space-y-1">
                <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-xl mb-2">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-800">Pembayaran Berhasil!</h3>
                <p class="text-xs text-gray-400">Transaksi telah dicatat dan disimpan</p>
            </div>

            <!-- Receipt Detail Print Area -->
            <div id="receipt-content" class="bg-gray-50 border border-dashed border-gray-300 rounded-xl p-4 text-xs font-mono space-y-3">
                <div class="text-center pb-2 border-b border-gray-200">
                    <p class="font-bold text-sm">KASIRKU STORE</p>
                    <p class="text-gray-500 text-[10px]">Jl. Contoh No. 123, Bandung</p>
                    <p id="receipt-date" class="text-gray-500 text-[10px] mt-1"></p>
                </div>
                <div id="receipt-items-list" class="space-y-1 py-1">
                    <!-- Dynamic receipt items -->
                </div>
                <div class="border-t border-gray-200 pt-2 space-y-1 text-gray-600">
                    <div class="flex justify-between"><span>Subtotal</span><span id="rec-sub">Rp 0</span></div>
                    <div class="flex justify-between"><span>Pajak (10%)</span><span id="rec-tax">Rp 0</span></div>
                    <div class="flex justify-between font-bold text-gray-900 border-t border-gray-200 pt-1"><span>Total</span><span id="rec-total">Rp 0</span></div>
                    <div class="flex justify-between text-gray-700 pt-1"><span>Bayar</span><span id="rec-cash">Rp 0</span></div>
                    <div class="flex justify-between text-indigo-600 font-bold"><span>Kembalian</span><span id="rec-change">Rp 0</span></div>
                </div>
                <div class="text-center pt-2 border-t border-gray-200 text-[10px] text-gray-400">
                    <p>Terima kasih atas kunjungan Anda!</p>
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex gap-3 pt-2">
                <button onclick="closeModal()" class="flex-1 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl text-sm transition">
                    Tutup
                </button>
                <button onclick="printReceipt()" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-print"></i>
                    <span>Cetak Struk</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Toast Box -->
    <div id="toast" class="fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-3 rounded-xl shadow-lg text-sm flex items-center space-x-3 transform translate-y-24 opacity-0 transition-all duration-300 z-50">
        <i id="toast-icon" class="fa-solid fa-info-circle text-indigo-400"></i>
        <span id="toast-msg">Pesan notifikasi</span>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Data Produk Mock
        const products = [
            { id: 1, name: "Nasi Goreng Spesial", price: 25000, stock: 15, category: "Makanan", icon: "fa-bowl-rice" },
            { id: 2, name: "Mie Ayam Bakso", price: 20000, stock: 12, category: "Makanan", icon: "fa-bowl-food" },
            { id: 3, name: "Ayam Geprek Sambal", price: 22000, stock: 8, category: "Makanan", icon: "fa-drumstick-bite" },
            { id: 4, name: "Es Teh Manis", price: 5000, stock: 40, category: "Minuman", icon: "fa-cup-straw" },
            { id: 5, name: "Es Jeruk Segar", price: 7000, stock: 25, category: "Minuman", icon: "fa-glass-water" },
            { id: 6, name: "Jus Alpukat", price: 15000, stock: 10, category: "Minuman", icon: "fa-blender" },
            { id: 7, name: "Kentang Goreng", price: 12000, stock: 20, category: "Snack", icon: "fa-fries" },
            { id: 8, name: "Roti Bakar Coklat", price: 14000, stock: 14, category: "Snack", icon: "fa-bread-slice" }
        ];

        let cart = [];
        let currentFilter = 'all';

        // Set Current Date on Header
        document.getElementById('current-date').innerText = new Date().toLocaleDateString('id-ID', {
            weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
        });

        // Initialize App
        window.onload = function() {
            renderProducts(products);
            setupSearch();
        };

        // Render Product Catalog
        function renderProducts(items) {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';

            if(items.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-10 text-gray-400 text-sm">
                        <i class="fa-solid fa-box-open text-3xl mb-1"></i>
                        <p>Produk tidak ditemukan</p>
                    </div>
                `;
                return;
            }

            items.forEach(product => {
                const isOutOfStock = product.stock <= 0;
                const card = document.createElement('div');
                card.className = `bg-white border border-gray-100 rounded-2xl p-4 flex flex-col justify-between shadow-sm hover:shadow-md transition group relative overflow-hidden ${isOutOfStock ? 'opacity-60' : 'cursor-pointer'}`;
                
                if(!isOutOfStock) {
                    card.onclick = () => addToCart(product.id);
                }

                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg group-hover:bg-indigo-600 group-hover:text-white transition">
                                <i class="fa-solid ${product.icon || 'fa-utensils'}"></i>
                            </div>
                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full ${product.stock > 5 ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600'}">
                                Stok: ${product.stock}
                            </span>
                        </div>
                        <h4 class="font-semibold text-sm text-gray-800 line-clamp-1">${product.name}</h4>
                        <p class="text-xs text-gray-400 mt-0.5">${product.category}</p>
                    </div>
                    <div class="mt-3 flex items-center justify-between pt-2 border-t border-gray-50">
                        <span class="font-bold text-indigo-600 text-sm">Rp ${product.price.toLocaleString('id-ID')}</span>
                        <button ${isOutOfStock ? 'disabled' : ''} class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center hover:bg-indigo-600 hover:text-white transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filter Products by Category
        function filterCategory(cat) {
            currentFilter = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-xl whitespace-nowrap hover:bg-gray-200 transition";
            });
            event.target.className = "cat-btn px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-xl whitespace-nowrap shadow-sm transition";
            
            applySearchAndFilter();
        }

        // Setup Search Listener
        function setupSearch() {
            document.getElementById('search-input').addEventListener('input', (e) => {
                applySearchAndFilter();
            });
        }

        // Combined Filter and Search
        function applySearchAndFilter() {
            const query = document.getElementById('search-input').value.toLowerCase();
            let filtered = products.filter(p => {
                const matchCategory = currentFilter === 'all' || p.category === currentFilter;
                const matchSearch = p.name.toLowerCase().includes(query);
                return matchCategory && matchSearch;
            });
            renderProducts(filtered);
        }

        // Add Item to Cart
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product || product.stock <= 0) return;

            const cartItem = cart.find(item => item.id === productId);
            if (cartItem) {
                if (cartItem.qty < product.stock) {
                    cartItem.qty++;
                } else {
                    showToast("Stok produk tidak mencukupi!", "error");
                    return;
                }
            } else {
                cart.push({ ...product, qty: 1 });
            }
            renderCart();
        }

        // Update Cart Quantity
        function updateQty(productId, delta) {
            const cartItem = cart.find(item => item.id === productId);
            const product = products.find(p => p.id === productId);
            
            if (cartItem) {
                const newQty = cartItem.qty + delta;
                if (newQty > 0) {
                    if (newQty <= product.stock) {
                        cartItem.qty = newQty;
                    } else {
                        showToast("Stok maksimum tercapai!", "error");
                        return;
                    }
                } else {
                    removeFromCart(productId);
                    return;
                }
            }
            renderCart();
        }

        // Remove Item from Cart
        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            renderCart();
        }

        // Clear Entire Cart
        function clearCart() {
            cart = [];
            renderCart();
            document.getElementById('cash-input').value = '';
            calculateChange();
        }

        // Render Cart UI & Calculate Totals
        function renderCart() {
            const container = document.getElementById('cart-items');
            
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center text-gray-400 py-10 flex flex-col items-center justify-center">
                        <i class="fa-solid fa-basket-shopping text-4xl mb-2 text-gray-300"></i>
                        <p class="text-sm">Keranjang masih kosong</p>
                    </div>
                `;
                document.getElementById('subtotal-price').innerText = 'Rp 0';
                document.getElementById('tax-price').innerText = 'Rp 0';
                document.getElementById('grand-total').innerText = 'Rp 0';
                document.getElementById('pay-btn').disabled = true;
                calculateChange();
                return;
            }

            container.innerHTML = '';
            let subtotal = 0;

            cart.forEach(item => {
                const itemSubtotal = item.price * item.qty;
                subtotal += itemSubtotal;

                const row = document.createElement('div');
                row.className = "py-2.5 flex items-center justify-between text-sm";
                row.innerHTML = `
                    <div class="flex-1 pr-2">
                        <h5 class="font-medium text-gray-800 line-clamp-1">${item.name}</h5>
                        <p class="text-xs text-gray-400">Rp ${item.price.toLocaleString('id-ID')} x ${item.qty}</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden bg-gray-50">
                            <button onclick="updateQty(${item.id}, -1)" class="px-2 py-1 text-gray-500 hover:bg-gray-200 transition"><i class="fa-solid fa-minus text-[10px]"></i></button>
                            <span class="px-2 text-xs font-semibold text-gray-700">${item.qty}</span>
                            <button onclick="updateQty(${item.id}, 1)" class="px-2 py-1 text-gray-500 hover:bg-gray-200 transition"><i class="fa-solid fa-plus text-[10px]"></i></button>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-rose-400 hover:text-rose-600 p-1 transition">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                    </div>
                `;
                container.appendChild(row);
            });

            const tax = subtotal * 0.10;
            const grandTotal = subtotal + tax;

            document.getElementById('subtotal-price').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('tax-price').innerText = `Rp ${tax.toLocaleString('id-ID')}`;
            document.getElementById('grand-total').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
            
            document.getElementById('pay-btn').disabled = false;
            calculateChange();
        }

        // Calculate Cash Change
        function calculateChange() {
            const grandTotalText = document.getElementById('grand-total').innerText;
            const grandTotal = parseInt(grandTotalText.replace(/[^0-9]/g, '')) || 0;
            const cashInput = parseInt(document.getElementById('cash-input').value) || 0;
            const change = cashInput - grandTotal;

            const changeEl = document.getElementById('change-amount');
            const payBtn = document.getElementById('pay-btn');

            if (cashInput >= grandTotal && grandTotal > 0) {
                changeEl.innerText = `Rp ${change.toLocaleString('id-ID')}`;
                changeEl.className = "text-base font-bold text-emerald-600";
                payBtn.disabled = false;
            } else {
                changeEl.innerText = grandTotal > 0 ? `Kurang Rp ${Math.abs(change).toLocaleString('id-ID')}` : 'Rp 0';
                changeEl.className = "text-base font-bold text-rose-600";
                if (cashInput < grandTotal || grandTotal === 0) {
                    payBtn.disabled = true;
                }
            }
        }

        // Process Payment & Open Receipt Modal
        function processPayment() {
            const subtotalText = document.getElementById('subtotal-price').innerText;
            const taxText = document.getElementById('tax-price').innerText;
            const totalText = document.getElementById('grand-total').innerText;
            const cashValue = document.getElementById('cash-input').value;
            const changeText = document.getElementById('change-amount').innerText;

            const subtotal = parseInt(subtotalText.replace(/[^0-9]/g, ''));
            const tax = parseInt(taxText.replace(/[^0-9]/g, ''));
            const total = parseInt(totalText.replace(/[^0-9]/g, ''));
            const cash = parseInt(cashValue);
            const change = cash - total;

            // Populate Receipt Modal Data
            document.getElementById('receipt-date').innerText = new Date().toLocaleString('id-ID');
            
            const listEl = document.getElementById('receipt-items-list');
            listEl.innerHTML = '';
            cart.forEach(item => {
                const div = document.createElement('div');
                div.className = "flex justify-between";
                div.innerHTML = `<span>${item.name} x${item.qty}</span> <span>Rp ${(item.price * item.qty).toLocaleString('id-ID')}</span>`;
                listEl.appendChild(div);
            });

            document.getElementById('rec-sub').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('rec-tax').innerText = `Rp ${tax.toLocaleString('id-ID')}`;
            document.getElementById('rec-total').innerText = `Rp ${total.toLocaleString('id-ID')}`;
            document.getElementById('rec-cash').innerText = `Rp ${cash.toLocaleString('id-ID')}`;
            document.getElementById('rec-change').innerText = `Rp ${change.toLocaleString('id-ID')}`;

            // Deduct stock temporarily in mock app memory
            cart.forEach(cartItem => {
                const prod = products.find(p => p.id === cartItem.id);
                if (prod) prod.stock -= cartItem.qty;
            });

            // Show Modal & Reset Cart
            document.getElementById('receipt-modal').classList.remove('hidden');
            renderProducts(products);
        }

        // Close Modal and Reset Cart state
        function closeModal() {
            document.getElementById('receipt-modal').classList.add('hidden');
            clearCart();
        }

        // Print Receipt simulation
        function printReceipt() {
            showToast("Struk berhasil dicetak!", "success");
            closeModal();
        }

        // Toast Notification System
        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toast-icon');
            document.getElementById('toast-msg').innerText = msg;

            if(type === "success") {
                icon.className = "fa-solid fa-check-circle text-emerald-400";
            } else {
                icon.className = "fa-solid fa-triangle-exclamation text-amber-400";
            }

            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
