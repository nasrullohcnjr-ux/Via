                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 text-sm font-medium">Rp</span>
                        <input type="number" id="cash-input" placeholder="0" oninput="calculateChange()"
                            class="w-full pl-9 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-base font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                    </div>
                </div>

                <div class="flex justify-between items-center bg-indigo-50/50 p-3 rounded-xl border border-indigo-100">
                    <span class="text-xs font-semibold text-indigo-900">Uang Kembalian:</span>
                    <span id="change-amount" class="text-base font-bold text-indigo-700">Rp 0</span>
                </div>

                <button onclick="processPayment()" id="pay-btn" disabled
                    class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-200 disabled:text-gray-400 text-white font-bold rounded-xl shadow-lg shadow-indigo-200 disabled:shadow-none transition flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-check-circle"></i>
